// Signing for macprompter Remote. Simulator builds need no Apple team.
//
// For a real iPhone create MacPrompterRemote/Signing.local.xcconfig (gitignored), e.g.:
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development
//   PRODUCT_BUNDLE_IDENTIFIER = com.example.macprompter.remote   // only if the ID is taken
PRODUCT_BUNDLE_IDENTIFIER = io.github.fng-2002.macprompter.remote
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
